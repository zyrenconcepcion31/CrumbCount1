
@model IEnumerable<CrumbCount2.Models.WasteRecording>

@{
    ViewData["Title"] = "Waste Records";
}

<h1>Waste Records</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Create New
    </a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Product</th>
            <th>Quantity Wasted</th>
            <th>Date Recorded</th>
            <th>Reason for Waste</th>
            <th>Remarks</th>
            <th>Unit Cost at Waste</th>
            <th>Total Waste Cost</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @(item.Product?.ProductName ?? "Unknown")
                </td>

                <td>
                    @item.QuantityWasted
                </td>

                <td>
                    @item.DateRecorded.ToString("MM/dd/yyyy")
                </td>

                <td>
                    @item.ReasonForWaste
                </td>

                <td>
                    @item.Remarks
                </td>

                <td>
                    @item.UnitCostAtWaste.ToString("C2",
                        new System.Globalization.CultureInfo("en-PH"))
                </td>

                <td>
                    @item.TotalWasteCost.ToString("C2",
                        new System.Globalization.CultureInfo("en-PH"))
                </td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.WasteRecordingId">Edit</a> |

                    <a asp-action="Details"
                       asp-route-id="@item.WasteRecordingId">Details</a> |

                    <a asp-action="Delete"
                       asp-route-id="@item.WasteRecordingId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
